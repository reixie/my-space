---
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  light: ImageMetadata;
  dark?: ImageMetadata;
  monochrome?: boolean;
  size?: number;
}

const { light, dark, monochrome = false, size = 16 } = Astro.props;
const [lightImage, darkImage] = monochrome ? [] : await Promise.all([
  getImage({ src: light, width: size * 2, height: size * 2, format: 'webp' }),
  dark ? getImage({ src: dark, width: size * 2, height: size * 2, format: 'webp' }) : null,
]);
---

{monochrome ? (
  <span
    class="mark monochrome"
    style={{ '--mark-size': `${size}px`, '--mark-image': `url("${light.src}")` }}
    aria-hidden="true"
  />
) : (
  <picture class="mark" style={{ '--mark-size': `${size}px` }}>
    {darkImage && <source media="(prefers-color-scheme: dark)" srcset={darkImage.src} />}
    <img src={lightImage!.src} alt="" width={size} height={size} />
  </picture>
)}

<style>
  .mark {
    display: block;
    flex-shrink: 0;
    width: var(--mark-size);
    height: var(--mark-size);
    overflow: hidden;
  }

  .mark img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    border-radius: 20%;
  }

  .monochrome {
    background: var(--color-text);
    mask-image: var(--mark-image);
    mask-repeat: no-repeat;
    mask-size: auto 100%;
    mask-position: left center;
  }
</style>
